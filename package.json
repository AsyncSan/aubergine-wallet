{
  "name": "aubergine-extension",
  "private": true,
  "license": "Apache-2.0",
  "version": "1.0.0",
  "type": "module",
  "description": "Aubergine browser extension (working title) - Stellar wallet that grows with you",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:testnet": "vitest run --config vitest.integration.config.ts",
    "test:mainnet": "vitest run --config vitest.integration.mainnet.config.ts",
    "pruefen": "bash scripts/selbstpruefung.sh"
  },
  "dependencies": {
    "@scure/bip39": "^2.2.0",
    "@stellar/stellar-sdk": "16.2.0",
    "@tanstack/react-query": "^5.66.0",
    "hash-wasm": "^4.12.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@wxt-dev/module-react": "^1.1.3",
    "buffer": "^6.0.3",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vitest": "^3.0.0",
    "wxt": "0.21.3"
  },
  "overrides": {
    "@vitejs/plugin-react": "^4.7.0"
  }
}
